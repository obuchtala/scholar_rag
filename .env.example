# Mistral AI API
MISTRAL_API_KEY=

# Semantic Scholar API — recommended for reliable corpus expansion (avoids rate-limit errors)
# Institutions and companies can request a key at https://www.semanticscholar.org/product/api
S2_API_KEY=

# Qdrant vector store
# When running `uv run scholar-rag` directly inside the devcontainer, use host.docker.internal
# so traffic reaches the sibling Qdrant container on the host Docker engine.
# On Linux you may need the Docker bridge gateway IP instead (usually 172.17.0.1).
# When running via `docker compose run app`, keep this as http://qdrant:6333 (compose network).
QDRANT_URL=http://host.docker.internal:6333
# Leave empty for local Qdrant; set for Qdrant Cloud
QDRANT_API_KEY=
QDRANT_COLLECTION=papers

# Langfuse observability (Langfuse Cloud — https://cloud.langfuse.com, free tier)
LANGFUSE_PUBLIC_KEY=pk-lf-...
LANGFUSE_SECRET_KEY=sk-lf-...
# LANGFUSE_HOST=https://cloud.langfuse.com  # default; override for self-hosted

# LLM model (default: mistralai:mistral-medium-3-5)
LLM_MODEL=mistralai:mistral-medium-3-5

# Project-wide cache directory (gitignored). Ingest saves S2 papers to $CACHE_DIR/s2-papers/.
# Default: cache/ (relative to project root)
# On persistent storage (e.g. DigitalOcean block storage):
# CACHE_DIR=/mnt/projects/cache/scholar-rag
CACHE_DIR=cache
